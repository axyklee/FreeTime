# Copy to `.dev.vars` for local development. Never commit `.dev.vars`.
# For production, set these with:  wrangler secret put <NAME>

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"

# Required so Auth.js builds correct callback URLs behind Cloudflare's proxy.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth — see README "Google OAuth setup" for exact Cloud Console steps.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only accounts on this email domain may sign in. Empty = allow any domain.
ALLOWED_EMAIL_DOMAIN="andrew.cmu.edu"

# Dev-only escape hatch: lets you sign in as any email WITHOUT Google OAuth,
# so you can click through the app before credentials exist.
# MUST be "false"/unset in production — it is refused outright when NODE_ENV=production.
ENABLE_DEV_LOGIN="true"

# --- Invitation email (Resend) -------------------------------------------
# Without a key the app still works: invites are saved and visible in-app, and
# the action reports plainly that no email was sent.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=""

# Must be an address on a domain you have verified in Resend. Resend's shared
# sandbox sender (onboarding@resend.dev) only delivers to your own account email.
EMAIL_FROM="FreeTime <invites@yourdomain.edu>"

# Public origin used for links inside outgoing email. Falls back to AUTH_URL.
APP_URL="http://localhost:3000"
